{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/voidfreud/mcpshape/main/src/mcpshape/schemas/upstream.schema.json",
  "title": "mcpshape upstream file",
  "$defs": {
    "CapOverrides": {
      "additionalProperties": false,
      "description": "One Upstream's or one Proxy's Caps: unset keeps what it inherits, set only ever lowers\nit.",
      "properties": {
        "tool_name": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ceiling on an exposed tool name, in characters.",
          "title": "Tool Name"
        },
        "tool_description": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ceiling on an exposed tool description, in characters.",
          "title": "Tool Description"
        },
        "argument_description": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ceiling on an exposed argument description, in characters.",
          "title": "Argument Description"
        },
        "instructions": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ceiling on the Proxy's exposed instructions, in characters.",
          "title": "Instructions"
        },
        "tool_output": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ceiling on a tool call's answer, in characters.",
          "title": "Tool Output"
        }
      },
      "title": "CapOverrides",
      "type": "object"
    },
    "HttpUpstreamFile": {
      "additionalProperties": false,
      "properties": {
        "transport": {
          "const": "http",
          "title": "Transport",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "version": {
          "const": 1,
          "description": "Format version of this file.",
          "title": "Version",
          "type": "integer"
        },
        "lifecycle": {
          "$ref": "#/$defs/LifecycleOverrides",
          "description": "This Upstream's lifecycle settings, over the defaults in config.toml."
        },
        "caps": {
          "$ref": "#/$defs/CapOverrides",
          "description": "This Upstream's Caps, over the global master Caps in config.toml."
        }
      },
      "required": [
        "transport",
        "url",
        "version"
      ],
      "title": "HttpUpstreamFile",
      "type": "object"
    },
    "LifecycleOverrides": {
      "additionalProperties": false,
      "description": "One Upstream's lifecycle settings: whatever it sets wins over the global defaults.",
      "properties": {
        "warm": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Connect at Daemon start and ping on an interval, instead of waiting for the first call. Warm Upstreams never go idle.",
          "title": "Warm"
        },
        "idle_timeout": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds without a call before the connection is let go. 0 keeps it forever.",
          "title": "Idle Timeout"
        },
        "connect_timeout": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds a connect attempt may take before it counts as a failure.",
          "title": "Connect Timeout"
        },
        "ping_interval": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds between pings of a warm Upstream, so it is never falsely reported up.",
          "title": "Ping Interval"
        },
        "unavailable_message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The tool error a call is answered with while the Upstream is not connected.",
          "title": "Unavailable Message"
        }
      },
      "title": "LifecycleOverrides",
      "type": "object"
    },
    "MemoryUpstreamFile": {
      "additionalProperties": false,
      "properties": {
        "transport": {
          "const": "memory",
          "title": "Transport",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z_][\\w.]*:[A-Za-z_]\\w*$",
          "title": "Target",
          "type": "string"
        },
        "version": {
          "const": 1,
          "description": "Format version of this file.",
          "title": "Version",
          "type": "integer"
        },
        "lifecycle": {
          "$ref": "#/$defs/LifecycleOverrides",
          "description": "This Upstream's lifecycle settings, over the defaults in config.toml."
        },
        "caps": {
          "$ref": "#/$defs/CapOverrides",
          "description": "This Upstream's Caps, over the global master Caps in config.toml."
        }
      },
      "required": [
        "transport",
        "target",
        "version"
      ],
      "title": "MemoryUpstreamFile",
      "type": "object"
    },
    "SseUpstreamFile": {
      "additionalProperties": false,
      "properties": {
        "transport": {
          "const": "sse",
          "title": "Transport",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "version": {
          "const": 1,
          "description": "Format version of this file.",
          "title": "Version",
          "type": "integer"
        },
        "lifecycle": {
          "$ref": "#/$defs/LifecycleOverrides",
          "description": "This Upstream's lifecycle settings, over the defaults in config.toml."
        },
        "caps": {
          "$ref": "#/$defs/CapOverrides",
          "description": "This Upstream's Caps, over the global master Caps in config.toml."
        }
      },
      "required": [
        "transport",
        "url",
        "version"
      ],
      "title": "SseUpstreamFile",
      "type": "object"
    },
    "StdioUpstreamFile": {
      "additionalProperties": false,
      "properties": {
        "transport": {
          "const": "stdio",
          "title": "Transport",
          "type": "string"
        },
        "command": {
          "title": "Command",
          "type": "string"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables the child process is given, on top of the small set (HOME, LOGNAME, PATH, SHELL, TERM, USER) the MCP SDK passes on. A value may be a ${VAR} reference, resolved from the Daemon environment or the secrets file.",
          "title": "Env",
          "type": "object"
        },
        "version": {
          "const": 1,
          "description": "Format version of this file.",
          "title": "Version",
          "type": "integer"
        },
        "lifecycle": {
          "$ref": "#/$defs/LifecycleOverrides",
          "description": "This Upstream's lifecycle settings, over the defaults in config.toml."
        },
        "caps": {
          "$ref": "#/$defs/CapOverrides",
          "description": "This Upstream's Caps, over the global master Caps in config.toml."
        }
      },
      "required": [
        "transport",
        "command",
        "version"
      ],
      "title": "StdioUpstreamFile",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "http": "#/$defs/HttpUpstreamFile",
      "memory": "#/$defs/MemoryUpstreamFile",
      "sse": "#/$defs/SseUpstreamFile",
      "stdio": "#/$defs/StdioUpstreamFile"
    },
    "propertyName": "transport"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/StdioUpstreamFile"
    },
    {
      "$ref": "#/$defs/HttpUpstreamFile"
    },
    {
      "$ref": "#/$defs/SseUpstreamFile"
    },
    {
      "$ref": "#/$defs/MemoryUpstreamFile"
    }
  ]
}
